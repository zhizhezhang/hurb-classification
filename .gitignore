!/reports/data_audit/class_counts.png
!/reports/data_audit/image_dimensions.png
/reports/data_cleaning/*
!/reports/data_cleaning/report.md
!/reports/data_cleaning/review_report.md
!/reports/data_cleaning/processing_summary.json
!/reports/data_cleaning/review_summary.json
!/reports/data_cleaning/review_decisions_submitted.csv
!/reports/data_cleaning/review_decisions_submitted.json
!/reports/data_cleaning/reviewed_clean_manifest.csv
!/reports/data_cleaning/reviewed_excluded_images.csv
!/reports/data_cleaning/confirmed_source_groups.csv
/reports/data_split/*
!/reports/data_split/class_to_idx.json
!/reports/data_split/preprocess_config.json
!/reports/data_split/split_config.json
!/reports/data_split/split_report.md
!/reports/data_split/validation_results.json
!/reports/data_split/class_split_counts.png
!/reports/data_split/train.csv
